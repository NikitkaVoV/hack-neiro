# Keep only the public submission documents; ignore internal project notes.
/docs/*
!/docs/ARCHITECTURE.md
!/docs/INSTALL_AND_USAGE.md
!/docs/LIMITATIONS.md
!/docs/TEST_RESULTS.md
!/docs/TEST_RESULTS.csv

# Keep generated APKs and historical experiments out of Git.
/artifacts/*

