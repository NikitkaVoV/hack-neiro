# Пример параметров финальной productionRelease-сборки.
# Gradle не загружает этот файл автоматически; реальные defaults заданы в android/app/build.gradle.kts.
APP_FLAVOR=production
BUILD_TYPE=release
ANDROID_ABI=arm64-v8a
ANDROID_MIN_SDK=30
NEMOTRON_QUANTIZATION=dynamic-int8
NEMOTRON_THRESHOLD=0.5
SPEAKER_EMBEDDING_MODEL=eres2net
SPEAKER_MATCHER_THRESHOLD=0.55
SPEAKER_MATCHER_ALLOW_MANY_TO_ONE=false
